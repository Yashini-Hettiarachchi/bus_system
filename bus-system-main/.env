# ─── News API Keys (server-side only, used in /api/news routes) ───────────────

# Currents API – real-time news feed (https://currentsapi.services)
CURRENTS_API_KEY=luJKxnx4U6tttvLVH3smdEbLkLTIXjUXE9ZXExYu82XyfLoX

# GNews API – alternative news source (https://gnews.io)
GNEWS_API_KEY=6f0a6994fe50944f5248ddc2b6048c85

# NewsData.io API – additional news provider (https://newsdata.io)
NewsData_API_KEY=pub_e82039ab6b934be3a2d39e84ecc6061c

# ─── Movies API (server-side only) ────────────────────────────────────────────

# TMDB (The Movie Database) API key – used for movie listings tab
# Replace YOUR_TMDB_API_KEY_HERE with your real key from https://themoviedb.org
TMDB_API_KEY=YOUR_TMDB_API_KEY_HERE

# ─── Disabled / Optional Keys (uncomment and fill in if needed) ───────────────

# VITE_ prefix exposes a variable to the browser bundle via Vite – use with care
# VITE_TMDB_API_KEY=YOUR_TMDB_API_KEY_HERE

# OpenWeather API – for a weather widget if added later (https://openweathermap.org)
# OPENWEATHER_API_KEY=1b9c8e5a0c3d2f1e7b8a9c6d4f5e2a3

# Google Maps API – for route/map features if added later
# GOOGLE_MAPS_API_KEY=AIzaSyD9X5v6n7o89p0q1r2s3t4u5v6w7x8y9z0

# ─── Bus Feedback Game – Google Apps Script ───────────────────────────────────

# Public /exec URL of the deployed Google Apps Script that writes passenger
# feedback answers to the "Feedback1" sheet in your Google Spreadsheet.
# VITE_ prefix is required so Vite embeds this value into the browser bundle.
# After changing this value, run  npm run build  and  vercel --prod --yes  to
# push the updated URL to production.
VITE_GAS_URL=https://script.google.com/macros/s/AKfycbzf6f5Fr7Biy-uxvpnOURiC7ckrf5q-eJsCbAAuN_RXvx78o8N_F3BqUKl3zMPvegOMUQ/exec
VITE_GAS_PREFS_URL=https://script.google.com/macros/s/AKfycbxKcZlhl9W6hZ7sxK3shuZHctzJQgTs1B51q_W-BQM9dvraTCBTsHIPKpQ2tWcdandkOA/exec

